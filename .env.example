# Copy to .env.local and fill in. Never commit .env.local.

# LinkedIn lookup keys (at least one). People Data Labs is tried first, then Apollo, then Apify.
PDL_API_KEY=
APIFY_TOKEN=
APOLLO_API_KEY=

# Local use on your own machine: server keys work without a login.
# npm run dev / npm run start listen on 127.0.0.1 only.
PATENT_LEDGER_TRUST_LOCAL=1

# Hosted use (for example Vercel): set these two instead and leave TRUST_LOCAL unset.
# PATENT_LEDGER_USERS={"admin":"<output of: node scripts/hash-password.mjs 'your-password'>"}
# PATENT_LEDGER_SESSION_SECRET=<32+ random characters>

# Not needed: the PatentsView API was retired in 2026; patent search uses the USPTO directly.
PATENTSVIEW_API_KEY=
